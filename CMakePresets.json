{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_MANIFEST_DIR": "${sourceDir}",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/.vcpkg_installed",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            }
        },
        {
            "name": "x64-windows-debug",
            "displayName": "x64-windows Debug (vcpkg manifest)",
            "inherits": "vcpkg-base",
            "binaryDir": "${sourceDir}/CMakeBuild/Ninja/Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-windows-release",
            "displayName": "x64-windows Release (vcpkg manifest)",
            "inherits": "vcpkg-base",
            "binaryDir": "${sourceDir}/CMakeBuild/Ninja/Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-windows-debug",
            "configurePreset": "x64-windows-debug"
        },
        {
            "name": "x64-windows-release",
            "configurePreset": "x64-windows-release"
        }
    ]
}